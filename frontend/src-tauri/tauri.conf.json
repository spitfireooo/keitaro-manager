{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Keitaro Manager",
  "version": "0.1.0",
  "identifier": "com.spitfireooo.keitaromanager",
  "build": {
    "frontendDist": "../dist-desktop",
    "devUrl": "http://127.0.0.1:1422",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build --mode desktop"
  },
  "app": {
    "windows": [
      {
        "title": "Keitaro Manager",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../public/third-party-licenses/lucide.txt": "licenses/lucide.txt"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
